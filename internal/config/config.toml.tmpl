# wt configuration
# See `wt config show` for the effective, layered values.

[create]
# Branch/ref new worktrees are created from.
# Empty = repo default branch (origin/HEAD, then main/master).
base_branch = "{{ .Create.BaseBranch }}"

# Where worktrees are placed. Relative paths resolve against the repo
# root. Supports the {repo} placeholder. The worktree name is appended.
# Empty = "../<repo>-worktrees".
dir = "{{ .Create.Dir }}"

# Branch name = prefix + separator + name (e.g. "jl" + "/" + "foo").
branch_prefix = "{{ .Create.BranchPrefix }}"
branch_separator = "{{ .Create.BranchSeparator }}"

[launch]
# Default editor/agent opened by the quick-launch key (e). One of the
# launcher names shown by the picker (e.g. "code", "cursor", "zed",
# "claude", "opencode"). Empty = the first available one.
default = "{{ .Launch.Default }}"

# Origin of an already-running `opencode web` server (e.g.
# "http://localhost:4096"). When set, the "opencode-web" launcher opens a deep
# link into that server for the worktree instead of starting a new one. Also
# honored via the OPENCODE_WEB_ORIGIN environment variable.
opencode_web_url = "{{ .Launch.OpencodeWebURL }}"
